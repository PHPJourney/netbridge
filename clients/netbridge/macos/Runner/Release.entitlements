<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider-systemextension</string>
	</array>
	<!-- file_picker (import config / bluetooth pick) requires user-selected
	     file access even for non-sandboxed apps — see FilePickerPlugin.swift. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Required to install/activate the WGExtension system extension.
	     The Developer ID profile must also carry this key (App ID capability
	     "System Extension" in Certificates, Identifiers & Profiles). -->
	<key>com.apple.developer.system-extension.install</key>
	<true/>
	<!-- Non-sandboxed: Developer ID direct distribution allows it, and the
	     desktop obfs2 bridge must spawn the external nbvpn binary
	     (/usr/local/bin/nbvpn obfs2 client). Hardened runtime + notarization
	     still apply (Xcode sets --options runtime). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.netbridge.netbridge</string>
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Keychain for flutter_secure_storage; list also mirrored to SharedPreferences -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.netbridge.netbridge</string>
	</array>
</dict>
</plist>
