<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Local trial entitlements for ad-hoc / self-sign builds (codesign --sign -).
  Intentionally OMIT Network Extension + App Groups (need Apple Team).
  Real WG tunnel on macOS still needs Developer Team + NE entitlements —
  see docs/delivery/nbvpn/TRY-CONNECT.md. NOT for App Store.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Best-effort Keychain; ad-hoc builds rely on SharedPreferences mirror for server list -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.netbridge.netbridge</string>
	</array>
</dict>
</plist>
