# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Apple signing material (private keys / certificates / profiles)
/apple/*.key
/apple/*.cer
/apple/*.p12
/apple/*.p8
/apple/*.mobileprovision
/apple/*.provisionprofile

# WireGuardKitGo build workspace (upstream repo + compiled libs)
/apple/vendor/
/apple/vendor-wireguard-apple/

# Local packaged binaries (CI artifacts preferred)
/dist/*.apk
/dist/*.dmg
/dist/*.ipa
/dist/*.exe
/dist/*.zip
/dist/*.sha256
/dist/NetBridge-macOS.app/
